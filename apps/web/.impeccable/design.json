      "html": "<div class=\"ds-track\"><span class=\"ds-rail\"></span><span class=\"ds-seg\" style=\"left:10%;width:20%;--c:var(--stage-applied)\"></span><span class=\"ds-seg\" style=\"left:30%;width:35%;--c:var(--stage-screen)\"></span><span class=\"ds-silence\" style=\"left:65%;width:30%\"></span><span class=\"ds-node ds-applied\" style=\"left:10%;--c:var(--stage-applied)\"></span><span class=\"ds-node\" style=\"left:30%;--c:var(--stage-screen)\"></span><span class=\"ds-node ds-unseen\" style=\"left:65%\"></span></div>",
      "css": ".ds-track{position:relative;width:420px;height:18px;background:var(--surface)}.ds-rail{position:absolute;left:0;right:0;top:50%;height:1px;background:var(--line)}.ds-seg{position:absolute;top:calc(50% - 1.5px);height:3px;border-radius:2px;background:var(--c)}.ds-silence{position:absolute;top:calc(50% - 1px);height:2px;background:repeating-linear-gradient(90deg,var(--stage-ghosted) 0 5px,transparent 5px 9px)}.ds-node{position:absolute;top:50%;width:10px;height:10px;border-radius:50%;background:var(--c);box-shadow:0 0 0 2px var(--surface);transform:translate(-50%,-50%)}.ds-applied{background:var(--surface);border:2px solid var(--c)}.ds-unseen{width:13px;height:13px;border:2px solid var(--ink);background:var(--scan)}"
