  "narrative": {
    "northStar": "The Tracking Page",
    "overview": "Applied draws every job application as a shipment being tracked, and every email as a scan. The interface borrows a carrier's tracking page: a painted livery bar, white label stock, and a progress line per application. It refuses the category's Kanban columns and grey tables. The pipeline is one shared timeline where each application's bar starts on the day you applied and runs to today. Silence is drawn to its real length, so ghosting is something you can see instead of something you forget.\n\nThe world shows up in the form, never in the words. Copy uses job vocabulary only (\"Moved to interview\", \"No news for 24 days\"), and the tracking metaphor lives in the bars, the scan-yellow node, the perforated label head, and the status word set large at the top of the detail panel. Everything else is plain, dense, standard product UI that a job seeker can operate without learning anything.\n\nThe screen is light, matching the daytime desk-and-phone scene it's used in. Colour does real work: the livery owns the shell, the stage colours encode progress, yellow encodes news, and grey encodes closure.",
    "keyCharacteristics": [
      "Deep spruce livery bar over cool white label stock",
      "One shared time axis for every application's tracking bar",
      "Dashed silence drawn to scale; yellow only for what's new",
      "Fixed stage colours, identical everywhere they appear",
      "One variable family (Archivo) with its width axis carrying the label character"
    ],
    "rules": [
      {
        "name": "The Scan Yellow Rule",
        "body": "Yellow means \"new since your last visit\" and nothing else. It is never a primary action, a focus ring, a warning or a decoration. If a screen has no news, it has no yellow.",
        "section": "colors"
      },
      {
        "name": "The Fixed Stage Colour Rule",
        "body": "Each stage owns one colour everywhere: tracking bars, chips, history nodes, filters, and the Sankey to come. A new surface reuses the set and never invents a stage colour.",
        "section": "colors"
      },
      {
        "name": "The Validated Stage Rule",
        "body": "The chromatic stage colours (screen, interview, final, offer, rejected) are checked as an ordered categorical palette with the data-viz validator: worst adjacent pair ΔE 10.9 under simulated protanopia and deuteranopia, 19.1 with normal vision, all ≥ 3:1 on white. Applied, ghosted and khaki outcomes are deliberate neutrals. Re-run the validator before changing any of them.",
        "section": "colors"
      },
      {
        "name": "The Grey but Kept Rule",
        "body": "A rejected, withdrawn or declined application drops to Closed Grey but keeps its row and history. An accepted offer keeps its colour.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Archivo carries every role. Emphasis comes from weight and width, never from a second face. Mono appears only where the content is a code: a reference or an email address.",
        "section": "typography"
      },
      {
        "name": "The Status Word Rule",
        "body": "On a detail view, the current status is the largest text in the panel, the way a tracking page leads with \"Delivered\".",
        "section": "typography"
      },
      {
        "name": "The Flat Stock Rule",
        "body": "Rows and boards never cast shadows. Depth is a floating panel or nothing.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do draw time to scale on a shared axis whenever more than one application is shown.",
      "Do mark news with the Scan Yellow node and the \"New\" pill, and clear it once the application is opened.",
      "Do reuse the stage colour set exactly, and grey closed applications without removing them.",
      "Do lead detail views with the status word at status scale (1.9rem, 720).",
      "Do use tabular figures for every date, count and duration."
    ],
    "donts": [
      "Don't use yellow for anything except news.",
      "Don't mark rows with coloured side stripes; news lives on the bar's node.",
      "Don't use shipping words in copy (\"delivered\", \"in transit\", \"parcel\"). The world stays in the form.",
      "Don't introduce a second typeface or use mono for anything but references and addresses.",
      "Don't put kickers or eyebrows above headings."
    ]
  }
}
