{
  "name": "@apptracker/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "typegen": "wrangler types",
    "typecheck": "wrangler types >/dev/null && tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@apptracker/core": "workspace:*",
    "@apptracker/mail": "workspace:*",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.3",
    "drizzle-kit": "0.31.11",
    "wrangler": "4.151.0"
  }
}
